# Copy to .env.local and fill in. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info

# Public site URL (used for canonical URLs, OG metadata)
NEXT_PUBLIC_SITE_URL=https://example.com

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Email — SMTP provider (used when siteConfig.providers.email === 'smtp')
# For Gmail: use an App Password, not your account password.
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com
  
# Email — Resend (used when siteConfig.providers.email === 'resend')
RESEND_API_KEY=

# Errors (optional)
SENTRY_DSN=

# Aleesa Web Chat — keep the API key server-side only (never NEXT_PUBLIC_).
# ALEESA_WEBHOOK_BASE_URL is the full Aleesa web-chat endpoint URL (with the path).
ALEESA_WEBCHAT_API_KEY=
ALEESA_WEBHOOK_BASE_URL=https://your-aleesa-webhook-server.com/webhooks/web-chat

# Aleesa Website Form intake — files contact-form submissions in the Aleesa CRM
# as a Lead with source "website_form", carrying the full submission.
#
# This runs ALONGSIDE the lead email above, not instead of it. Either one
# landing is enough, so running on Aleesa alone (no SMTP) is a supported setup.
#
# Setup, once:
#   1. Aleesa dashboard > Settings > Connections > Website Form >
#      "Enable Website Form". Copy the key there and then — afterwards only a
#      masked version is shown, and regenerating it invalidates the old key
#      immediately.
#   2. Paste it as ALEESA_WEBSITE_FORM_API_KEY below.
#   3. ALEESA_API_URL is the Aleesa *API* origin — a different host from
#      ALEESA_WEBHOOK_BASE_URL above. Either an origin or the full submit URL
#      works: the path "/api/v1/integrations/website-form/submit" is appended
#      by the adapter only when it is not already there.
#
#      Heads up: the dashboard card can print the submit URL against
#      "api-aleesa.ai", which does not resolve. It derives that host from the
#      browser URL when the dashboard's own API base is unset. The host that
#      answers is api.aleesa.ai — hyphen to dot.
#
# Server-only secret, like the web chat key: anyone holding it can file leads
# as this tenant. Never rename it with a NEXT_PUBLIC_ prefix.
ALEESA_API_URL=https://api.aleesa.ai
ALEESA_WEBSITE_FORM_API_KEY=

# Server Action ID encryption key — pins Server Action IDs across builds so
# clients don't get UnrecognizedActionError after a redeploy. Generate with:
#   openssl rand -base64 32
# Same value must be set in Vercel for Production, Preview, and Development.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
